{
  "name": "Post-Registration Onboarding",
  "description": "Automatically trigger onboarding workflows when new registrations are created - sends welcome emails, creates checklists, and grants access",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "RegistrationSubmission"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "post_registration_onboarding",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onboardingAutomation",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onboardingAutomation"
  }
}